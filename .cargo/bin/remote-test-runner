#!/usr/bin/env sh
set -eu

binary=$1

shift

target_dir=$(cd "$(dirname "$binary")/../.." && pwd)
driver="$target_dir/release/wisp-test-runner"

if [ ! -x "$driver" ]; then
    echo "Missing device test driver: run 'just test' to build it first." >&2
    exit 1
fi

remote=$(adb shell mktemp -d /data/local/tmp/wisp-tests.XXXXXX | tr -d '\r')

[ -n "$remote" ] || exit 1
trap 'adb shell rm -rf "$remote" >/dev/null 2>&1 || true' EXIT
adb push "$binary" "$remote/tests" >/dev/null
adb push "$driver" "$remote/runner" >/dev/null
adb shell chmod +x "$remote/tests" "$remote/runner"

# adb shell joins its arguments: quote every value for the device shell.
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

command="WISP_TEST_TIMEOUT=$(quote "${WISP_TEST_TIMEOUT:-30}") $(quote "$remote/runner") $(quote "$remote/tests")"

for arg do
    command="$command $(quote "$arg")"
done

adb shell "$command"
